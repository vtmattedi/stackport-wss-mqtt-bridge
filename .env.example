# v0 external endpoints — secrets belong in a PRIVATE .env (never committed).
# Required: Dedicated token with Stackport scope "status", NOT an admin/MCP token.
SP_WSS_URL=wss://sp.mattediworks.com/status/ws
SP_STATUS_TOKEN=
# Stable instance ID from Stackport > Settings > Live status.
# Required before MQTT CONNECT, to choose the retained Last Will topic.
SP_INSTANCE=

# Required: dedicated Stackport-Mqtt Dynamic Security account.
MQTT_URL=mqtts://mqtt.mattediworks.com:8883
MQTT_USERNAME=stackport-bridge
MQTT_PASSWORD=
# Public CA certificate included in this repository; private keys are NOT included.
MQTT_TLS_CA_FILE=certs/nm-root-ca.crt
MQTT_TLS_SERVERNAME=mqtt.mattediworks.com

# Optional v0 knobs. Safe topic prefix; ACL must match.
MQTT_TOPIC_PREFIX=stackport
SP_STALE_AFTER_S=90
SP_NO_FRAME_TIMEOUT_S=90
LOG_LEVEL=info
