# Copy to .env (gitignored). Secrets are never committed.
# V0 exclusively uses externally reachable TLS endpoints.
# Stackport > Settings > Live status (status-only, ALL projects).
SP_INSTANCE=sp-replace-with-your-instance-id
SP_EXPECTED_SCOPE=all
SP_WS_URL=wss://sp.mattediworks.com/status/ws
SP_STATUS_TOKEN=

# Existing Stackport-Mqtt TLS/TCP broker (NOT browser WebSocket port 9001).
MQTT_URL=mqtts://mqtt.mattediworks.com:8883
MQTT_TLS_SERVERNAME=mqtt.mattediworks.com
# PUBLIC trust anchor; don't put private CA keys here.
MQTT_CA_FILE=./certs/nm-root-ca.crt
# Stable, unique per running bridge. Only ONE publisher per SP_INSTANCE.
MQTT_CLIENT_ID=stackport-bridge-primary
MQTT_USERNAME=stackport-bridge
MQTT_PASSWORD=

# Proposed v0 defaults, tuned by integration tests.
SOURCE_STALE_AFTER_SECONDS=90
WS_SILENCE_TIMEOUT_SECONDS=90
WS_RECONNECT_MIN_MS=1000
WS_RECONNECT_MAX_MS=30000
MQTT_RECONNECT_MS=3000
MQTT_KEEPALIVE_SECONDS=30
LOG_LEVEL=info
