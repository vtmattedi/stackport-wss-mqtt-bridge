# Copy to .env (gitignored). Keep all actual credentials private.
# Stackport Settings -> Live status (v1.3.11+).
SP_INSTANCE=sp-replace-with-your-instance-id
SP_EXPECTED_SCOPE=all
# Host-local topology. Use verified wss:// domain for a managed container.
SP_WS_URL=ws://127.0.0.1:3000/status/ws
# Create a dedicated status-only token in Stackport; never use MCP/admin sessions.
SP_STATUS_TOKEN=

# Stackport-Mqtt TLS-only Mosquitto broker via existing host TCP exposure.
# If using a managed container, adjust the reachable destination accordingly.
MQTT_URL=mqtts://127.0.0.1:8883
# Must match the broker leaf certificate SAN, even with IP/Docker service destination.
MQTT_TLS_SERVERNAME=mqtt.mattediworks.com
# PUBLIC CA certificate. Never put the NM root private key in this project.
MQTT_CA_FILE=./certs/nm-root-ca.crt
# Unique per bridge instance (one live writer per SP_INSTANCE).
MQTT_CLIENT_ID=stackport-bridge-primary
# Dedicated Mosquitto Dynamic Security publish-only client.
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional behavior settings (proposed v0 defaults).
SOURCE_STALE_AFTER_SECONDS=90
WS_SILENCE_TIMEOUT_SECONDS=90
WS_RECONNECT_MIN_MS=1000
WS_RECONNECT_MAX_MS=30000
MQTT_RECONNECT_MS=3000
MQTT_KEEPALIVE_SECONDS=30
LOG_LEVEL=info
